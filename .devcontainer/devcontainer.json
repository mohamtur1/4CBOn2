{
  "name": "4CBOn2 OpenCode Dev",
  "image": "mcr.microsoft.com/devcontainers/universal:latest",
  "features": {
    "ghcr.io/devcontainers/features/node:latest": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/python:latest": {
      "version": "3.11"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-jupyter.jupyter",
        "ms-toolsai.jupyter-keymap",
        "GitHub.copilot",
        "eamodio.gitlens"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": true,
        "[python]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "ms-python.python"
        },
        "jupyter.notebookFileRoot": "${workspaceFolder}"
      }
    }
  },
  "postCreateCommand": "npm install -g opencode-ai@latest && pip install -q gradio chromadb PyPDF2 python-docx duckduckgo-search beautifulsoup4 fpdf2 openai sentence-transformers jupyter",
  "remoteUser": "codespace",
  "forwardPorts": [7860, 8888],
  "portsAttributes": {
    "7860": {
      "label": "Gradio UI",
      "onAutoForward": "notify"
    },
    "8888": {
      "label": "Jupyter",
      "onAutoForward": "notify"
    }
  }
}
