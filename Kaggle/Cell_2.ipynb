def prompt_text(s):
    def edit(line):
        end = "\n" if line.endswith("\n") else ""; body = line[:-1] if end else line
        if "`current_frame` exposes only" in body: body = "- `current_frame` exposes `.ascii`, `.step`, `.level`, `.shape`, `.grid`, and `.segmentation`."
        elif "raw numeric grid is intentionally not exposed" in body: body = "- `.grid` is immutable tuple-of-tuples of numeric color IDs; use `.grid[row][col]` for exact tests and `.segmentation` for object summaries."
        elif "`history[i].frame`" in body and "exposes only" in body: body = body.split(" exposes only ", 1)[0] + " exposes `.ascii`, `.step`, `.level`, `.shape`, `.grid`, and `.segmentation`."
        elif "current_frame.segmentation` as your primary view" in body: body = "- Use `current_frame.grid` for exact cell/color tests, segmentation for objects, and `.ascii` only for small regions."
        if "`last_animation_frames`" in body: a, sep, b = body.partition("`.ascii`, `.shape` and `.segmentation`"); body = a + "`.ascii`, `.shape`, `.grid`, and `.segmentation`" + b if sep else body
        return body + end
    return "".join(edit(line) for line in s.splitlines(keepends=True))
