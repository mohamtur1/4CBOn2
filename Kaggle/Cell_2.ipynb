def assignment(tree, name): return next(n.value for n in tree.body if isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == name for t in n.targets))
def span(raw, node):
    lines = raw.splitlines(keepends=True); a = sum(map(len, lines[:node.lineno-1])) + node.col_offset
    return a, sum(map(len, lines[:node.end_lineno-1])) + node.end_col_offset
def put_node(path, raw, node, value):
    a, b = span(raw, node); out = raw[:a] + repr(value).encode() + raw[b:]; ast.parse(out.decode()); path.write_bytes(out)
def rewrite_literals(path, update):
    raw = path.read_bytes(); tree = ast.parse(raw.decode())
    edits = [(*span(raw, n), repr(v).encode()) for n in ast.walk(tree) if isinstance(n, ast.Constant) and isinstance(n.value, str) if (v := update(n.value)) != n.value]
    for a, b, value in sorted(edits, reverse=True): raw = raw[:a] + value + raw[b:]
    ast.parse(raw.decode()); path.write_bytes(raw)
def add_grid(value):
    code = textwrap.dedent(value); tree = ast.parse(code); cls = next(n for n in ast.walk(tree) if isinstance(n, ast.ClassDef) and n.name == "FrameView")
    if any(isinstance(n, ast.FunctionDef) and n.name == "grid" for n in cls.body): return code
    seg = next(n for n in cls.body if isinstance(n, ast.FunctionDef) and n.name == "segmentation"); line = min((d.lineno for d in seg.decorator_list), default=seg.lineno)
    prop = textwrap.indent("@property\ndef grid(self):\n    view = getattr(self, '_grid_view', None)\n    if view is None:\n        view = tuple(tuple(row) for row in self._grid)\n        self._grid_view = view\n    return view\n\n", "    ")
    lines = code.splitlines(keepends=True); lines.insert(line-1, prop); return "".join(lines)
